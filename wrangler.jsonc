{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pokemonchampions-pro",
  "main": "./cloudflare-worker.mjs",
  "account_id": "f374eebcbf49e49d869c284792be5d54",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "pokemonchampions.pro",
      "custom_domain": true
    },
    {
      "pattern": "www.pokemonchampions.pro",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
