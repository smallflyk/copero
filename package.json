{
  "name": "copero-football-career-simulator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components data lib tests scripts --max-warnings 0",
    "test": "node --test tests/*.test.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "preview:cloudflare": "npm run build && wrangler dev",
    "deploy:cloudflare": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "next": "^15.5.24",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "20.19.41",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "wrangler": "^4.127.1"
  },
  "overrides": {
    "postcss": "^8.5.30"
  }
}
